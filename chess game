import tkinter as tk
import chess
import random

# Create window
root = tk.Tk()
root.title("Chess Game")

# Chess board
board = chess.Board()
selected_square = None

# Scores
player_score = 0
computer_score = 0

# Piece values
piece_values = {
    chess.PAWN: 1,
    chess.KNIGHT: 3,
    chess.BISHOP: 3,
    chess.ROOK: 5,
    chess.QUEEN: 9,
    chess.KING: 0
}

# Score label
score_label = tk.Label(root, text="Player: 0  Computer: 0", font=("Arial", 14))
score_label.grid(row=0, column=0, columnspan=8)

# Buttons dictionary
buttons = {}

# Chess symbols
pieces = {
    'P': '♙','R': '♖','N': '♘','B': '♗','Q': '♕','K': '♔',
    'p': '♟','r': '♜','n': '♞','b': '♝','q': '♛','k': '♚'
}

# Update score display
def update_score():
    score_label.config(text=f"Player: {player_score}  Computer: {computer_score}")

# Update board UI
def update_board():
    for square in chess.SQUARES:
        row = 7 - (square // 8)
        col = square % 8

        piece = board.piece_at(square)
        text = pieces[piece.symbol()] if piece else ""

        buttons[(row, col)].config(text=text)

# Player move
def on_click(r, c):
    global selected_square, player_score

    square = chess.square(c, 7 - r)

    if selected_square is None:
        selected_square = square
    else:
        move = chess.Move(selected_square, square)

        if move in board.legal_moves:
            # Capture check
            if board.is_capture(move):
                captured_piece = board.piece_at(square)
                if captured_piece:
                    player_score += piece_values[captured_piece.piece_type]

            board.push(move)
            selected_square = None

            update_score()
            update_board()

            if not board.is_game_over():
                root.after(500, computer_move)
        else:
            selected_square = None

# Computer move (simple AI)
def computer_move():
    global computer_score

    moves = list(board.legal_moves)

    if moves:
        move = random.choice(moves)

        # Capture check
        if board.is_capture(move):
            captured_piece = board.piece_at(move.to_square)
            if captured_piece:
                computer_score += piece_values[captured_piece.piece_type]

        board.push(move)

        update_score()
        update_board()

# Create board UI
for r in range(8):
    for c in range(8):
        color = "white" if (r + c) % 2 == 0 else "gray"

        btn = tk.Button(root, width=6, height=3, bg=color,
                        command=lambda r=r, c=c: on_click(r, c))
        btn.grid(row=r+1, column=c)

        buttons[(r, c)] = btn

# Initialize board
update_board()

# Run app
root.mainloop
